# Entity: map

main: kit: entity: map: {

  alias: field: {}

  fields: {
    assetPath: {
      h: "Asset Path"
      n: "assetPath"
      r: false
      sh: "Asset path in game files"
      t: "`$STRING`"
    }
    callouts: {
      h: "Callouts"
      n: "callouts"
      r: false
      t: "`$ARRAY`"
    }
    coordinates: {
      h: "Coordinates"
      n: "coordinates"
      r: false
      sh: "Geographic coordinates of the map location"
      t: "`$STRING`"
    }
    displayIcon: {
      fo: "uri"
      h: "Display Icon"
      n: "displayIcon"
      r: false
      sh: "URL to the map's display icon"
      t: "`$STRING`"
    }
    displayName: {
      h: "Display Name"
      n: "displayName"
      r: false
      sh: "Display name of the map"
      t: "`$STRING`"
    }
    listViewIcon: {
      fo: "uri"
      h: "List View Icon"
      n: "listViewIcon"
      r: false
      sh: "URL to the map's list view icon"
      t: "`$STRING`"
    }
    mapUrl: {
      fo: "uri"
      h: "Map Url"
      n: "mapUrl"
      r: false
      sh: "URL to the map overview"
      t: "`$STRING`"
    }
    narrativeDescription: {
      h: "Narrative Description"
      n: "narrativeDescription"
      r: false
      sh: "Narrative description of the map"
      t: "`$STRING`"
    }
    splash: {
      fo: "uri"
      h: "Splash"
      n: "splash"
      r: false
      sh: "URL to the map's splash image"
      t: "`$STRING`"
    }
    tacticalDescription: {
      h: "Tactical Description"
      n: "tacticalDescription"
      r: false
      sh: "Tactical description of the map"
      t: "`$STRING`"
    }
    uuid: {
      fo: "uuid"
      h: "Uuid"
      n: "uuid"
      r: false
      sh: "Unique identifier for the map"
      t: "`$STRING`"
    }
    xMultiplier: {
      h: "X Multiplier"
      n: "xMultiplier"
      r: false
      sh: "X coordinate multiplier"
      t: "`$NUMBER`"
    }
    xScalarToAdd: {
      h: "X Scalar To Add"
      n: "xScalarToAdd"
      r: false
      sh: "X scalar to add"
      t: "`$NUMBER`"
    }
    yMultiplier: {
      h: "Y Multiplier"
      n: "yMultiplier"
      r: false
      sh: "Y coordinate multiplier"
      t: "`$NUMBER`"
    }
    yScalarToAdd: {
      h: "Y Scalar To Add"
      n: "yScalarToAdd"
      r: false
      sh: "Y scalar to add"
      t: "`$NUMBER`"
    }
  }

  id: {
    field: "uuid"
    name: "id"
  }

  name: "map"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/maps"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "en-US"
                k: "query"
                n: "language"
                or: "language"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/maps"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "maps"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/maps/{uuid}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "uuid"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "en-US"
                k: "query"
                n: "language"
                or: "language"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/maps/{uuid}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              uuid: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "maps"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
