# Entity: agent

main: kit: entity: agent: {

  alias: field: {}

  fields: [
    {
      name: "abilities"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "assetPath"
      req: false
      type: "`$STRING`"
    }
    {
      name: "background"
      req: false
      type: "`$STRING`"
    }
    {
      name: "backgroundGradientColors"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "bustPortrait"
      req: false
      type: "`$STRING`"
    }
    {
      name: "characterTags"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "developerName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "displayIcon"
      req: false
      type: "`$STRING`"
    }
    {
      name: "displayIconSmall"
      req: false
      type: "`$STRING`"
    }
    {
      name: "displayName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "fullPortrait"
      req: false
      type: "`$STRING`"
    }
    {
      name: "fullPortraitV2"
      req: false
      type: "`$STRING`"
    }
    {
      name: "isAvailableForTest"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "isBaseContent"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "isFullPortraitRightFacing"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "isPlayableCharacter"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "killfeedPortrait"
      req: false
      type: "`$STRING`"
    }
    {
      name: "role"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "uuid"
      req: false
      type: "`$STRING`"
    }
    {
      name: "voiceLine"
      req: false
      type: "`$OBJECT`"
    }
  ]

  name: "agent"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "is_playable_character"
                orig: "is_playable_character"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "en-US"
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/agents"
          parts: [
            "v1"
            "agents"
          ]
          select: {
            exist: [
              "is_playable_character"
              "language"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "uuid"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "en-US"
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/agents/{uuid}"
          parts: [
            "v1"
            "agents"
            "{id}"
          ]
          rename: {
            param: {
              uuid: "id"
            }
          }
          select: {
            exist: [
              "id"
              "language"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
