# Entity: map

main: kit: entity: map: {

  alias: field: {}

  fields: [
    {
      name: "assetPath"
      req: false
      short: "Asset path in game files"
      type: "`$STRING`"
    }
    {
      name: "callouts"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "coordinates"
      req: false
      short: "Geographic coordinates of the map location"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "displayIcon"
      req: false
      short: "URL to the map's display icon"
      type: "`$STRING`"
    }
    {
      name: "displayName"
      req: false
      short: "Display name of the map"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "listViewIcon"
      req: false
      short: "URL to the map's list view icon"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "mapUrl"
      req: false
      short: "URL to the map overview"
      type: "`$STRING`"
    }
    {
      name: "narrativeDescription"
      req: false
      short: "Narrative description of the map"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "splash"
      req: false
      short: "URL to the map's splash image"
      type: "`$STRING`"
    }
    {
      name: "tacticalDescription"
      req: false
      short: "Tactical description of the map"
      type: "`$STRING`"
    }
    {
      format: "uuid"
      name: "uuid"
      req: false
      short: "Unique identifier for the map"
      type: "`$STRING`"
    }
    {
      name: "xMultiplier"
      req: false
      short: "X coordinate multiplier"
      type: "`$NUMBER`"
    }
    {
      name: "xScalarToAdd"
      req: false
      short: "X scalar to add"
      type: "`$NUMBER`"
    }
    {
      name: "yMultiplier"
      req: false
      short: "Y coordinate multiplier"
      type: "`$NUMBER`"
    }
    {
      name: "yScalarToAdd"
      req: false
      short: "Y scalar to add"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "map"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "en-US"
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/maps"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "maps"
            }
          ]
          select: {
            exist: [
              "language"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "uuid"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "en-US"
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/maps/{uuid}"
          rename: {
            param: {
              uuid: "id"
            }
          }
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "maps"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "language"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
