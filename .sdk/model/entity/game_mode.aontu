# Entity: game_mode

main: kit: entity: game_mode: {

  alias: field: {}

  fields: [
    {
      name: "allowsMatchTimeouts"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "assetPath"
      req: false
      type: "`$STRING`"
    }
    {
      name: "displayIcon"
      req: false
      type: "`$STRING`"
    }
    {
      name: "displayName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "duration"
      req: false
      type: "`$STRING`"
    }
    {
      name: "economyType"
      req: false
      type: "`$STRING`"
    }
    {
      name: "gameFeatureOverrides"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "gameRuleBoolOverrides"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "isMinimapHidden"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "isTeamVoiceAllowed"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "orbCount"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "roundsPerHalf"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "teamRoles"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "uuid"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "game_mode"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "en-US"
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/gamemodes"
          parts: [
            "v1"
            "gamemodes"
          ]
          select: {
            exist: [
              "language"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
