# Entity: weapon

main: kit: entity: weapon: {

  alias: field: {}

  fields: {
    assetPath: {
      h: "Asset Path"
      n: "assetPath"
      r: false
      sh: "Asset path in game files"
      t: "`$STRING`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      sh: "Weapon category (e.g., Rifle, Pistol)"
      t: "`$STRING`"
    }
    defaultSkinUuid: {
      fo: "uuid"
      h: "Default Skin Uuid"
      n: "defaultSkinUuid"
      r: false
      sh: "UUID of the default skin"
      t: "`$STRING`"
    }
    displayIcon: {
      fo: "uri"
      h: "Display Icon"
      n: "displayIcon"
      r: false
      sh: "URL to the weapon's display icon"
      t: "`$STRING`"
    }
    displayName: {
      h: "Display Name"
      n: "displayName"
      r: false
      sh: "Display name of the weapon"
      t: "`$STRING`"
    }
    killStreamIcon: {
      fo: "uri"
      h: "Kill Stream Icon"
      n: "killStreamIcon"
      r: false
      sh: "URL to the weapon's kill stream icon"
      t: "`$STRING`"
    }
    shopData: {
      h: "Shop Data"
      n: "shopData"
      r: false
      t: "`$OBJECT`"
    }
    skins: {
      h: "Skins"
      n: "skins"
      r: false
      t: "`$ARRAY`"
    }
    uuid: {
      fo: "uuid"
      h: "Uuid"
      n: "uuid"
      r: false
      sh: "Unique identifier for the weapon"
      t: "`$STRING`"
    }
    weaponStats: {
      h: "Weapon Stats"
      n: "weaponStats"
      r: false
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "uuid"
    name: "id"
  }

  name: "weapon"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/weapons"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "en-US"
                k: "query"
                n: "language"
                or: "language"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/weapons"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "weapons"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/weapons/{uuid}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "uuid"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "en-US"
                k: "query"
                n: "language"
                or: "language"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/weapons/{uuid}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              uuid: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "weapons"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
