# BasicAgentFlow

main: kit: flow: BasicAgentFlow:
{
  entity: "agent",
  kind: "basic",
  name: "BasicAgentFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_ref01",
        srcdatavar: "agent_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "agent01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentFlow"
}